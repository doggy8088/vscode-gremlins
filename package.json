{
  "name": "code-gremlins-detector",
  "displayName": "程式碼除妖鏡 (Gremlins Tracker)",
  "version": "0.26.0",
  "publisher": "doggy8088",
  "author": {
    "name": "Will 保哥",
    "email": "doggy.huang@gmail.com",
    "url": "https://www.facebook.com/will.fans"
  },
  "contributors": [
    {
      "name": "Will 保哥",
      "url": "https://github.com/doggy8088"
    },
    {
      "name": "Anthony Ricaud",
      "url": "https://github.com/rik"
    },
    {
      "name": "Jon Senchyna",
      "url": "https://github.com/TheSench"
    }
  ],
  "description": "偵測與標記程式碼中隱藏的、不可見的或容易混淆的干擾字元（如零寬空格、希臘問號等），防範潛在的程式編譯與執行錯誤。",
  "icon": "images/gremlins-dark.png",
  "galleryBanner": {
    "color": "#843534",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://github.com/doggy8088/vscode-gremlins/",
  "repository": "https://github.com/doggy8088/vscode-gremlins.git",
  "badges": [
    {
      "href": "https://marketplace.visualstudio.com/items?itemName=doggy8088.code-gremlins-detector",
      "url": "https://img.shields.io/vscode-marketplace/d/doggy8088.code-gremlins-detector.svg",
      "description": "Visual Studio 擴充功能市集"
    },
    {
      "href": "https://marketplace.visualstudio.com/items?itemName=doggy8088.code-gremlins-detector",
      "url": "https://img.shields.io/github/package-json/v/doggy8088/vscode-gremlins.svg",
      "description": "GitHub 套件版本"
    }
  ],
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "程式碼除妖鏡 (Gremlins)",
      "properties": {
        "gremlins.color_info": {
          "type": "string",
          "default": "rgba(60, 118, 61, .75)",
          "markdownDescription": "「提示 (info)」等級的標記高亮顏色"
        },
        "gremlins.color_warning": {
          "type": "string",
          "default": "rgba(138, 109, 59, .75)",
          "markdownDescription": "「警告 (warning)」等級的標記高亮顏色"
        },
        "gremlins.color_error": {
          "type": "string",
          "default": "rgba(169, 68, 66, .75)",
          "markdownDescription": "「錯誤 (error)」等級的標記高亮顏色"
        },
        "gremlins.characters": {
          "type": "object",
          "description": "套件應追蹤的干擾字元列表",
          "scope": "language-overridable",
          "default": {
            "2013": {
              "description": "連接號 (en dash)",
              "level": "warning"
            },
            "2018": {
              "description": "左單引號 (left single quotation mark)",
              "level": "warning"
            },
            "2019": {
              "description": "右單引號 (right single quotation mark)",
              "level": "warning"
            },
            "2029": {
              "zeroWidth": true,
              "description": "段落分隔符 (paragraph separator)",
              "level": "error"
            },
            "2066": {
              "zeroWidth": true,
              "description": "左至右字元 (Left to right)",
              "level": "error"
            },
            "2069": {
              "zeroWidth": true,
              "description": "方向格式終止字元 (Pop directional)",
              "level": "error"
            },
            "0003": {
              "description": "文字結束字元 (end of text)",
              "level": "warning"
            },
            "000b": {
              "description": "垂直定位字元 (line tabulation)",
              "level": "warning"
            },
            "00a0": {
              "description": "不換行空格 (non breaking space)",
              "level": "info"
            },
            "00ad": {
              "description": "軟連字號 (soft hyphen)",
              "level": "info"
            },
            "200b": {
              "zeroWidth": true,
              "description": "零寬空格 (zero width space)",
              "level": "error"
            },
            "200c": {
              "zeroWidth": true,
              "description": "零寬不連字字元 (zero width non-joiner)",
              "level": "warning"
            },
            "200e": {
              "zeroWidth": true,
              "description": "左至右標記 (left-to-right mark)",
              "level": "error"
            },
            "201c": {
              "description": "左雙引號 (left double quotation mark)",
              "level": "warning"
            },
            "201d": {
              "description": "右雙引號 (right double quotation mark)",
              "level": "warning"
            },
            "202c": {
              "zeroWidth": true,
              "description": "方向格式終止字元 (pop directional formatting)",
              "level": "error"
            },
            "202d": {
              "zeroWidth": true,
              "description": "左至右覆蓋 (left-to-right override)",
              "level": "error"
            },
            "202e": {
              "zeroWidth": true,
              "description": "右至左覆蓋 (right-to-left override)",
              "level": "error"
            },
            "fffc": {
              "zeroWidth": true,
              "description": "物件替換字元 (object replacement character)",
              "level": "error"
            }
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "level"
            ],
            "properties": {
              "zeroWidth": {
                "type": "boolean",
                "description": "此字元是否為零寬字元"
              },
              "description": {
                "type": "string",
                "description": "此字元的中文描述"
              },
              "level": {
                "type": "string",
                "description": "此字元標記的嚴重嚴重程度等級（預設為 error）",
                "default": "error",
                "enum": [
                  "none",
                  "info",
                  "warning",
                  "error"
                ],
                "enumDescriptions": [
                  "不標記 - 用於停用其他作用域定義的字元（例如預設值）",
                  "使用「提示 (info)」顏色高亮，並在問題面板中記錄為「提示」",
                  "使用「警告 (warning)」顏色高亮，並在問題面板中記錄為「警告」",
                  "使用「錯誤 (error)」顏色高亮，並在問題面板中記錄為「錯誤」"
                ]
              },
              "hideGutterIcon": {
                "type": "boolean",
                "description": "若設為 true，將隱藏此字元在側邊欄 (gutter) 的除妖鏡圖記"
              },
              "overviewRulerColor": {
                "type": "boolean",
                "description": "在右側概覽尺規 (overview ruler) 中顯示的顏色（預設為深紅色）"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "gremlins.gutterIconSize": {
          "type": "string",
          "default": "75%",
          "description": "側邊欄 (gutter) 的除妖鏡圖記大小"
        },
        "gremlins.showInProblemPane": {
          "type": "boolean",
          "default": false,
          "description": "是否在 VS Code「問題 (Problems)」面板中顯示偵測到的干擾字元"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint ./extension.js",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --write '**/*{js,json}'",
    "test": "jest"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "jest": "^28.1.3",
    "prettier": "^2.8.8",
    "vscode-test": "^1.6.1"
  }
}
